@model IEnumerable<SportsConnect.Models.TeamRosterSummaryViewModel>

@{
    ViewData["Title"] = "View Rosters";
}

<div class="container mt-5">
    <h1 class="mb-4">Team Rosters</h1>

    @if (Model.Any())
    {
        @foreach (var team in Model)
        {
            <div class="card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h2 class="section-title mb-2">@team.TeamName</h2>
                        <p class="mb-1"><strong>Sport:</strong> @team.Sport</p>
                        <p class="mb-1"><strong>Location:</strong> @team.Location</p>
                        <p class="mb-1"><strong>Experience Level:</strong> @team.ExperienceLevel</p>
                    </div>

                    <div class="text-end">
                        <div class="member-count mb-2">
                            Current Members: @team.CurrentMembers
                        </div>

                        <a class="btn btn-theme px-4 py-2" asp-controller="Memberships" asp-action="Index"
                               asp-route-teamId="@team.TeamId">
                            Manage Roster
                        </a>
                    </div>

                </div>

                <details>
                    <summary>View Members</summary>

                    @if (team.Members.Any())
                    {
                        <table class="mt-3">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Role</th>
                                    <th>Position</th>
                                    <th>Joined</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in team.Members)
                                {
                                    <tr>
                                        <td>@member.UserName</td>

                                        <td>
                                            @if (member.IsTeamLead)
                                            {
                                                <span class="badge team-lead-badge">Team Lead</span>
                                            }
                                            else
                                            {
                                                <span class="badge member-badge">Member</span>
                                            }
                                        </td>

                                        <td>
                                            @(string.IsNullOrEmpty(member.Position) ? "N/A" : member.Position)
                                        </td>

                                        <td>@member.JoinDate.ToString("MMMM d, yyyy")</td>
                                        <td>@member.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="mt-3">This team does not have any members yet.</p>
                    }
                </details>
            </div>
        }
    }
    else
    {
        <div class="card p-4">
            <p>You do not currently lead any teams.</p>
            <a class="btn btn-theme" asp-controller="Teams" asp-action="Create">Create Team</a>
        </div>
    }