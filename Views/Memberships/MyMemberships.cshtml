@model IEnumerable<SportsConnect.Models.MembershipTeamViewModel>

@{
    ViewData["Title"] = "My Memberships";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">My Memberships</h1>

        <a class="btn btn-theme" asp-controller="Teams" asp-action="Index">
            Find a Local Team
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var membership in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card p-4 h-100">
                        <h2 class="section-title">@membership.TeamName</h2>

                        <p><strong>Sport:</strong> @membership.Sport</p>
                        <p><strong>Location:</strong> @membership.Location</p>
                        <p><strong>Experience Level:</strong> @membership.ExperienceLevel</p>
                        <p><strong>Position:</strong> @membership.Position</p>
                        <p><strong>Status:</strong> @membership.Status</p>
                        <p><strong>Joined:</strong> @membership.JoinDate.ToShortDateString()</p>

                        <div class="d-flex gap-2 mt-3">
                            <a class="btn btn-outline-primary"
                                   href="mailto:@membership.LeaderEmail?subject=Regarding @membership.TeamName">
                                Email Team Leader
                            </a>

                            <form asp-controller="Memberships" asp-action="LeaveTeam" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="membershipId" value="@membership.MembershipId" />
                                <button class="btn btn-outline-danger" type="submit">Leave Team</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card p-4">
            <p>You are not currently a member of any teams.</p>
            <div class="mt-3">
                <a class="btn btn-theme px-4" asp-controller="Teams" asp-action="Index">
                    Search Teams
                </a>
            </div>
        </div>
    }
</div>