@model SportsConnect.Models.User

@{
    ViewData["Title"] = "Profile";
}

<div class="container mt-4">
    <div class="card">
        <h1>Profile</h1>

        <p><strong>Name:</strong> @Model.FirstName @Model.LastName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>City:</strong> @Model.City</p>
        <p><strong>Province:</strong> @Model.Province</p>
        <p><strong>Country:</strong> @Model.Country</p>

        <div class="mt-4">
            <a class="btn btn-theme d-inline-block" asp-action="EditProfile">
                Edit Profile
            </a>
        </div>
    </div>
</div>