@model SportsConnect.Models.ApplicationViewModel

@{
    ViewData["Title"] = "Application Details";
}

<div class="container mt-5" style="max-width: 800px;">
    <div class="card p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Application Details</h1>

            <a class="btn btn-outline-primary" asp-action="Index">
                Back to Applications
            </a>
        </div>

        <p><strong>Applicant:</strong> @Model.UserName</p>
        <p><strong>Team:</strong> @Model.TeamName</p>
        <p><strong>Application Date:</strong> @Model.ApplicationDate.ToShortDateString()</p>
        <p><strong>Status:</strong> @Model.Status</p>

        <hr />

        <h2 class="section-title mb-3">Application Responses</h2>

        <div style="white-space: pre-line;">
            @Model.Responses
        </div>

        @if (Model.Status == "Pending" && ViewBag.CanReview == true)
        {
            <div class="d-flex gap-2 mt-4">
                <form asp-action="Approve" asp-route-id="@Model.ApplicationId" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-theme" type="submit">Approve</button>
                </form>

                <form asp-action="Deny" asp-route-id="@Model.ApplicationId" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-danger" type="submit">Deny</button>
                </form>
            </div>
        }
    </div>
</div>