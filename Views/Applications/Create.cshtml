@model SportsConnect.Models.Application

@{
    ViewData["Title"] = "Submit Application";
}

<div class="container mt-5" style="max-width: 900px;">
    <div class="card p-4">
        <h1 class="mb-2">Submit Application</h1>
        <p class="text-muted mb-4">
            Complete the application below. The team leader will review your responses.
        </p>

        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="TeamId" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Preferred Position</label>
                    <select name="PreferredPosition" class="form-select" required>
                        <option value="">Select preferred position</option>
                        <option>Player</option>
                        <option>Goalie</option>
                        <option>Defense</option>
                        <option>Midfield</option>
                        <option>Forward</option>
                        <option>Flexible / Any Position</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Why do you want to join this team?</label>
                <textarea name="ReasonForJoining" class="form-control" rows="4" required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">What is your availability for practices and games?</label>

                <div class="row">
                    @foreach (var day in new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday",
            "Sunday" })
                    {
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@day</label>
                            <select name="@day" class="form-select">
                                <option value="">Not Available</option>
                                <option>Morning (7am-12pm)</option>
                                <option>Afternoon (12pm-5pm)</option>
                                <option>Evening (5pm-11pm)</option>
                                <option>Any Time</option>
                            </select>
                        </div>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Tell us about any relevant skills or achievements</label>
                <textarea name="Skills" class="form-control" rows="4"></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label">Additional comments or questions</label>
                <textarea name="Comments" class="form-control" rows="4"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-theme" type="submit">Submit Application</button>
                <a class="btn btn-outline-primary" asp-controller="Teams" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>