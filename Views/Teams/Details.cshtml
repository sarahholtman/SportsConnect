@model SportsConnect.Models.Team

@{
    ViewData["Title"] = "Team Details";
}

<div class="container mt-5">
    <div class="card p-4">
        <h1 class="mb-3">@Model.TeamName</h1>

        <div class="team-detail-list">
            <p><strong>Sport:</strong> @Model.Sport</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p><strong>Experience Level:</strong> @Model.ExperienceLevel</p>
        </div>

        <div class="d-flex gap-2 mt-4">
            <a class="btn btn-theme" asp-controller="Applications" asp-action="Create" asp-route-teamId="@Model.TeamId">
                Submit Application
            </a>

            <a class="btn btn-outline-primary" asp-action="Index">
                Back to Teams
            </a>
        </div>
    </div>
</div>